# Copy to ~/.openclaw/.env on the gateway host and fill in. Never commit the real file.

# Free tier: https://build.nvidia.com (key starts with nvapi-)
NVIDIA_API_KEY=

# Free tier web search: https://brave.com/search/api/
BRAVE_API_KEY=

# Last-resort fallback for the research agents (Haiku, cheap)
ANTHROPIC_API_KEY=

# Optional: cheap paid account, then add its model to the fallbacks in research-agents.json5
# OPENROUTER_API_KEY=
